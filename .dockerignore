# Keep local configuration and generated deployment material out of the build context.
# Example templates are intentionally included. Keep other secrets outside the source tree.
configs/config.yaml
**/.env
**/.env.*
!**/.env.example
deploy/mcp/tls/
deploy/sqlite/tls/
deploy/mcp/recovery/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.age

.git

# Local build and test artifacts
bin/
__pycache__/
*.py[cod]

# Source illustrations for the hosted product videos are not runtime assets
docs/media/product-overview/images/

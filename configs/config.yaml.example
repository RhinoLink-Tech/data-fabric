# Data Fabric 配置模板：复制为 configs/config.yaml 后按需修改。
# 服务配置环境变量按配置路径映射：server.port -> SERVER_PORT。
# 敏感字段建议注入环境变量，不要写进文件：
#   DATABASE_USERNAME / DATABASE_PASSWORD / SECURITY_JWT_SECRET
# 兼容变量：DATABASE_NAME -> database.database，JWT_SECRET -> security.jwt_secret。
# 完整映射见 docs/configuration.md 的 "Environment Variables" 一节。

server:
  port: "8080"
  mode: "debug"  # debug, release, test
  # HTTP 监听地址（#127）：IP 或可解析主机名；留空监听全部接口（容器友好）。
  host: "0.0.0.0"
  # HTTP limits (#128). Fetch operations may run up to 30 minutes.
  read_header_timeout: "10s"
  read_timeout: "30s"
  write_timeout: "31m"
  idle_timeout: "120s"
  max_request_body_bytes: 1048576

database:
  host: "localhost"
  port: "3306"
  database: "data_fabric"
  username: "data_fabric"   # 或 export DATABASE_USERNAME=...
  password: ""              # 或 export DATABASE_PASSWORD=...
  # 元数据库 TLS（#143）：false=不加密（默认）；true=TLS 且校验证书；
  # skip-verify=TLS 但不校验证书（自签场景）。其它值启动即报错。
  ssl: "false"

security:
  # 不写入文件：export JWT_SECRET=$(openssl rand -base64 32)
  #jwt_secret: ""
  jwt_expiration: "24h"
  # enable_auth 只控制数据源管理端点（/api/v1/datasources、/api/v1/database）；
  # /api/v1/fetch 无论开关都需要 Bearer token（#6）。本地自签一枚（24h 有效，需 pyjwt）：
  # python3 -c "import jwt,time; print(jwt.encode({'userId':'dev','tenantId':'acme','username':'dev','roles':['admin'],'iat':int(time.time()),'exp':int(time.time())+86400}, '与JWT_SECRET相同的值', algorithm='HS256'))"
  # 注意：HTTP 服务启动即要求合法 JWT_SECRET（非空、非占位、≥32 字节，#8/#6）；
  # release 模式下也不允许将 enable_auth 设为 false。
  # 数据源按所有者/租户授权（#9）：token 里的 userId/tenantId 决定可见范围，
  # roles 含 admin 则不受限；tenantId 可省略（默认桶）。详见 docs/configuration.md
  # 的 "Data source authorization" 一节。/api/v1/database/health 与
  # /api/v1/database/connections/stats 需要 admin 角色。
  enable_auth: true
  enable_rate_limit: true
  rate_limit_per_minute: 60
  rate_limit_burst: 10
  # 数据库级只读会话强制（#20）：MySQL/PostgreSQL 系引擎的连接以只读打开，
  # 引擎本身拒绝写操作（纵深防御，应用层 SELECT 校验之外的第二道防线）。
  # release 模式下不允许关闭；个别引擎不支持时，可对该数据源单独关闭：
  # additionalProps: { enforce_read_only: false }（详见 docs/readonly-access.md）。
  enforce_read_only: true

logging:
  level: "info"
  format: "json"  # json, text

query:
  prefer_streaming: true
  execution_mode: "auto"  # auto, streaming, pagination

mcp:
  enabled: false
  transport: "stdio" # stdio or streamable-http
  address: "127.0.0.1:8081"
  tls_cert_file: "" # configure with tls_key_file for direct HTTPS
  tls_key_file: ""
  auth_mode: "local-jwt" # local-jwt for development; oidc for protected remote MCP
  oidc_issuer: ""
  oidc_audience: ""
  oidc_required_scopes: "data-fabric.query"
  oidc_scope_claim: "scope"
  oidc_tenant_claim: "tenant"
  oidc_roles_claim: "roles"
  oidc_username_claim: "preferred_username"
  oidc_jwks_refresh_interval: "5m"

# SQL dialect translation runtime. The image includes Python and the pinned SQLGlot package.
sql_translation:
  enabled: true
  timeout: "5s"
  max_concurrent: 4
  max_sql_bytes: 1048576
  max_output_bytes: 1048576
  python_path: "python3"
  script_path: "./scripts/sql_translate.py"
  python_module_path: "/opt/data-fabric/python"

# Data Fabric remote MCP quickstart — deployment secrets template (#186).
# Copy to .env next to docker-compose.yml and fill in every value.
# Deployment and source credentials belong to you: nothing here is committed,
# and the server rejects known placeholder values at startup.
#
# Generate each secret with: openssl rand -base64 32

# JWT signing secret for the local HTTP management API only (>= 32 bytes).
# Remote MCP access uses an access token issued by your OIDC identity provider.
JWT_SECRET=

# OIDC resource configuration for the remote MCP endpoint. Register
# data-fabric-mcp as an audience and grant the configured query scope in your
# identity provider. Issuer and audience must match its OIDC-signed JWT access token.
MCP_OIDC_ISSUER=
MCP_OIDC_AUDIENCE=
MCP_OIDC_REQUIRED_SCOPES=data-fabric.query
MCP_OIDC_SCOPE_CLAIM=scope
# Optional claim mapping (dot paths are supported for nested role claims).
MCP_OIDC_TENANT_CLAIM=tenant
MCP_OIDC_ROLES_CLAIM=roles
MCP_OIDC_USERNAME_CLAIM=preferred_username
MCP_OIDC_JWKS_REFRESH_INTERVAL=5m

# Credential vault: encrypts data-source credentials at rest.
#   DATA_FABRIC_CREDENTIAL_ACTIVE_KEY_ID: any label without ':', e.g. key-1
#   DATA_FABRIC_CREDENTIAL_KEYS: JSON object {"key-1":"<base64 32-byte key>"}
# Example:
#   DATA_FABRIC_CREDENTIAL_ACTIVE_KEY_ID=key-1
#   DATA_FABRIC_CREDENTIAL_KEYS={"key-1":"$(openssl rand -base64 32)"}
DATA_FABRIC_CREDENTIAL_ACTIVE_KEY_ID=key-1
DATA_FABRIC_CREDENTIAL_KEYS=

# Metadata database (stores the configured data sources).
METADATA_DB_ROOT_PASSWORD=
METADATA_DB_PASSWORD=

# Sample queryable source (MySQL by default; docker-compose.postgres.yml swaps
# in PostgreSQL and reuses these same secrets).
SAMPLE_SOURCE_ROOT_PASSWORD=
SAMPLE_READER_PASSWORD=

# Host port bindings. The API stays on loopback; the MCP endpoint publishes on
# all interfaces because it is TLS-protected. Change the bindings, not just
# the numbers, to match your exposure decision (see docs/mcp-deployment.md).
API_PORT=8080
MCP_HTTPS_PORT=8443
